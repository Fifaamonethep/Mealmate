# App environment
VITE_APP_NAME=MyApp
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# JWT
VITE_JWT_STORAGE_KEY=auth_token
VITE_JWT_EXP_MINUTES=60

# API
VITE_API_BASE_URL=https://sokepromax.space
VITE_API_AUTH=https://sokepromax.space/auth
VITE_API_DOCUMENT=https://sokepromax.space/api/document-service
VITE_API_USER=https://sokepromax.space/auth/user

# Frontend URL (useful for auth callbacks)
VITE_APP_URL=https://sokepromax.space

# Feature flags
VITE_FEATURE_DEBUG=true
VITE_FEATURE_MAINTENANCE_MODE=false

# App type (for multi-tenant or CMS setups)
VITE_APP_TYPE=cms
